{
  "name": "azelle-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:api": "npm --prefix server run dev",
    "start:api": "npm --prefix server start",
    "test": "node scripts/check-storefront.mjs",
    "test:api": "node scripts/check-api.mjs",
    "check": "npm run build && npm test",
    "format:check": "prettier --check src/pages/ProductDetails.tsx src/lib/pageMeta.ts src/entry-server.tsx server/src/routes/support.js server/src/routes/pages.js",
    "test:dummy": "node --env-file=server/.env scripts/check-local-recovery.mjs",
    "test:dummy:commerce": "node --env-file=server/.env scripts/check-dummy-commerce.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "connect-mongo": "^6.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mongoose": "^9.10.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "type": "module"
}
