# Copy to server/.env (not committed) and fill in real values.
PORT=4000

# Local MongoDB: mongodb://127.0.0.1:27017/azelle
# Atlas:        mongodb+srv://<user>:<password>@<cluster>/azelle
MONGODB_URI=mongodb://127.0.0.1:27017/azelle

# Long random string used to sign the admin session cookie (required in production).
SESSION_SECRET=change-me

# Admin sign-in (required). Never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Set automatically on Vercel when a Blob store is connected (admin image uploads).
# BLOB_READ_WRITE_TOKEN=

# ── Payments & shipping (see server/src/commerce.config.js) ──
# Leave any partner empty to switch it off.
# PUBLIC_SITE_URL=https://azelle-web.vercel.app
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=sandbox
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# DELHIVERY_API_TOKEN=
# DELHIVERY_ENV=staging
# PICKUP_LOCATION_NAME=Primary
# PICKUP_PINCODE=
# ── Analytics: Microsoft Clarity ──
# CLARITY_PROJECT_ID=      (Clarity → Settings → Overview)
# CLARITY_API_TOKEN=       (Clarity → Settings → Data Export → Generate new API token)
