# Copy to server/.env (not committed) and fill in real values.
PORT=4000

# Local MongoDB: mongodb://127.0.0.1:27017/azelle
# Atlas:        mongodb+srv://<user>:<password>@<cluster>/azelle
MONGODB_URI=mongodb://127.0.0.1:27017/azelle

# Long random string used to sign the admin session cookie (required in production).
SESSION_SECRET=change-me

# Admin sign-in (required). Never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Set automatically on Vercel when a Blob store is connected (admin image uploads).
# BLOB_READ_WRITE_TOKEN=
